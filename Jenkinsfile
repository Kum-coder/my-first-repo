pipeline {
  agent any
  stages {
      stage('Welcome') {
           steps {
                echo "welcome to jenkins"

           }
      }
    stage('Build') {
        steps {
             echo "build started well"
             echo "preparing"

        }
    }
   stage('Test') {
      steps {
           echo "testing the application"
      }
  }
  stage('Deploy') {
      steps {
          echo " application deployed"
      }
  }
}
}
